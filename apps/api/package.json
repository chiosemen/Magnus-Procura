{
  "name": "@magnus/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec tsx watch src/index.ts",
    "worker:scoring:dev": "pnpm exec tsx watch src/scoring-worker.ts",
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint src tests scripts --max-warnings=0",
    "test": "pnpm exec vitest run tests/unit tests/integration --config vitest.config.ts --reporter=verbose && pnpm exec playwright test --config playwright.config.ts",
    "worker:scoring": "node dist/scoring-worker.js"
  },
  "dependencies": {
    "@google/genai": "1.41.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "jose": "5.9.6",
    "pg": "8.16.3",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "zod": "3.24.2",
    "agent-core": "workspace:*",
    "agent-policies": "workspace:*",
    "agent-provider-openai": "workspace:*",
    "agent-provider-gemini": "workspace:*",
    "agent-provider-anthropic": "workspace:*",
    "shared-types": "workspace:*",
    "shared-utils": "workspace:*",
    "agent-tool-supplier": "workspace:*",
    "agent-tool-buyer": "workspace:*",
    "agent-tool-scoring": "workspace:*",
    "agent-tool-vault": "workspace:*",
    "agent-tool-syndication": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.0.0",
    "tsx": "4.19.2"
  }
}
