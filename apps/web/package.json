{
  "name": "@magnus/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec vite",
    "build": "pnpm exec vite build",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint src --max-warnings=0",
    "test": "pnpm exec vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shared-types": "workspace:*",
    "shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "vite": "7.3.1"
  }
}
