{
  "name": "agent-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "pnpm exec tsc -p tsconfig.json --watch",
    "build": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint src --max-warnings=0",
    "test": "pnpm exec vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "3.24.2"
  }
}
