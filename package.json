{
  "name": "magnus-procura",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "workspaces": [],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "governor": "node scripts/governor-check.js",
    "boundary:check": "depcruise --config governance/dependency-rules.js .",
    "pr-score": "pnpm exec tsx scripts/pr-score.ts",
    "invariant:ci": "node scripts/invariants/run-all.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@playwright/test": "1.50.1",
    "@types/node": "25.2.3",
    "dependency-cruiser": "17.1.0",
    "eslint": "9.20.0",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "3.0.5"
  }
}
