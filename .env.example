# Magnus Procura — Environment Configuration
# ==========================================
# This monorepo has TWO environment surfaces. Copy the per-app examples rather
# than this file:
#
#   cp apps/web/.env.example apps/web/.env.local   # browser-delivered, NEXT_PUBLIC_* only
#   cp apps/api/.env.example apps/api/.env         # privileged: secrets live here only
#
# Per docs/SECURITY-POLICY.md S1, no secret may ever appear in apps/web.
# scripts/invariants/check-no-client-secrets.mjs enforces this in CI.

# --- Local test database -----------------------------------------------------
# Required by `pnpm db:setup`, the RLS authorization suite, and
# scripts/invariants/check-rls-coverage.mjs. A local throwaway database only:
# never point this at a production or staging instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/magnus_ci
