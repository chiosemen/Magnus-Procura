NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://app.magnusprocura.com
DATABASE_URL=postgresql://magnus:replace-me@127.0.0.1:5432/magnus_procura
JWT_SECRET=replace-with-at-least-32-char-secret
SESSION_COOKIE_NAME=magnus_session
SESSION_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=true

# Auth identities (bcrypt hashes, never plain text)
AUTH_SUPPLIER_USERNAME=supplier_user
AUTH_SUPPLIER_PASSWORD_HASH=$2a$10$suIN22IfN0Qf8I0V4El4j.56co2fYMeN3Q26f2So6xkhvL67SYN9m
AUTH_BUYER_USERNAME=buyer_user
AUTH_BUYER_PASSWORD_HASH=$2a$10$J2tD8UXXR4S8fYMvQBLVh.vZOwQt40AwR6r5xwu4jh8IaAej8F7.K
AUTH_ADMIN_USERNAME=admin_user
AUTH_ADMIN_PASSWORD_HASH=$2a$10$4ILjRj6ntb2kcsI6eVdB3uhMZWGNM6f3j7Fu3h33y5g8dkUQ5MBP.

# Provider key (server-only, never exposed to client)
GEMINI_API_KEY=replace-with-real-provider-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Scoring worker
SCORING_WORKER_MAX_ATTEMPTS=10
SCORING_WORKER_RETRY_BASE_MS=1000
SCORING_WORKER_POLL_INTERVAL_MS=500
SCORING_WORKER_ML_MODE=disabled

# Agent layer
AGENT_MAX_RUNTIME_MS=15000
AGENT_MAX_RUNS_PER_MINUTE=20
AGENT_MAX_RUNS_PER_DAY=500

# Observability
LOG_LEVEL=info
TELEMETRY_DSN=
